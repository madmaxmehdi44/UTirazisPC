# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WordPress & WooCommerce Headless Commerce Provider Configuration
WORDPRESS_URL=https://utirazis.flywheelsites.com
WPGRAPHQL_URL=https://utirazis.flywheelsites.com/graphql

# Server-only HTTP Basic Auth credentials (required if Flywheel Basic Auth lock is active)
# WORDPRESS_BASIC_USER=flywheel
# WORDPRESS_BASIC_PASSWORD=

# Server-only WooCommerce REST API keys (used only for privileged server operations)
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=

# Public site URL for canonical links, metadata, and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional admin token for server-side custom administration endpoints
# TIRAZIS_ADMIN_TOKEN=
